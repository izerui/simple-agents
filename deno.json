{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "imports": {
    "@pyodide/pyodide": "https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js",
    "@deno/": "./scripts/"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run --allow-env",
    "test:runner": "deno test --allow-read --allow-write --allow-run --allow-env scripts/uvx_runner",
    "run:runner": "deno run --allow-read --allow-write --allow-run --allow-env scripts/uvx_runner/mod.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "check": "deno check **/*.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-unused-vars",
        "no-explicit-any"
      ]
    },
    "exclude": [
      ".venv/",
      "node_modules/"
    ]
  },
  "test": {
    "include": [
      "**/*_test.ts",
      "**/*.test.ts"
    ],
    "exclude": [
      ".venv/",
      "node_modules/"
    ]
  },
  "exclude": [
    ".venv/",
    "node_modules/",
    "__pycache__/",
    "*.pyc",
    ".git/",
    ".pytest_cache/"
  ]
}
