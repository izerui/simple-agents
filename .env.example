# Uncomment the following line to add your LangSmith API key
# LANGSMITH_API_KEY=your-api-key
# Or if you have a LangSmith Deployment license key, then uncomment the following line:
# LANGGRAPH_CLOUD_LICENSE_KEY=your-license-key
# Add any other environment variables go below...

# 沙箱根目录(容器内的绝对路径)
SANDBOX_ROOT_DIR=/deps/simple-agents/data/sandbox_sessions

# MODEL 配置
#MODEL_PROVIDER=anthropic
#MODEL_BASE_URL=https://open.bigmodel.cn/api/anthropic
#MODEL_API_KEY=900874d9188d1ddd81385212a5a679a8.FxiXw8iQbR6EA6hf
#MODEL_MODEL_ID=claude-sonnet-4-5

# MODEL
MODEL_PROVIDER=anthropic
MODEL_BASE_URL=https://open.bigmodel.cn/api/anthropic
MODEL_API_KEY=xxx
MODEL_MODEL_ID=claude-sonnet-4-5

# vl MODEL
VL_MODEL_PROVIDER=openai
VL_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VL_MODEL_API_KEY=xxx
VL_MODEL_MODEL_ID=qwen3-vl-8b-instruct
#VL_MODEL_MODEL_ID=qwen3-vl-plus


# LangSmith 配置
LANGSMITH_API_KEY=xxx
LANGCHAIN_TRACING_V2=true
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=simple-agents

PYDEVD_DISABLE_FILE_VALIDATION=1
ENABLED_AGENT_DEBUG=0

# Langgraph 配置
LANGGRAPH_API_KEY=xxx

# 浏览器抓取服务配置
# 生产环境（Docker Compose）: http://browser-service:2025
# 开发环境（本地）: http://127.0.0.1:2025
BROWSER_SERVICE_URL=http://127.0.0.1:2025
BROWSER_SERVICE_TIMEOUT=60

BROWSER_SERVICE_URL=http://127.0.0.1:2025