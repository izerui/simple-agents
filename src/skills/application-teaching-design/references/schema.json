{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/application-teaching-design/final-schema.json",
  "title": "Application Teaching Design Final Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "标题",
    "课程设计名称",
    "课程信息",
    "学习目标",
    "学习先决知识",
    "知识建模图",
    "课上资源",
    "课下资源",
    "活动序列"
  ],
  "properties": {
    "标题": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "课程设计名称": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "课程信息": {
      "$ref": "#/$defs/courseInfo"
    },
    "学习目标": {
      "$ref": "#/$defs/learningGoals"
    },
    "学习先决知识": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledgePoint"
      }
    },
    "知识建模图": {
      "$ref": "#/$defs/knowledgeMap"
    },
    "课上资源": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceDescriptor"
      }
    },
    "课下资源": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceDescriptor"
      }
    },
    "活动序列": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "idString": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "learningLevel": {
      "type": "string",
      "enum": [
        "记忆",
        "理解",
        "运用"
      ]
    },
    "location": {
      "type": "string",
      "enum": [
        "课上",
        "课下"
      ]
    },
    "knowledgePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "名称",
        "学习水平"
      ],
      "properties": {
        "名称": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "学习水平": {
          "$ref": "#/$defs/learningLevel"
        },
        "说明": {
          "type": "string"
        }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "地址"
      ],
      "properties": {
        "地址": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "说明": {
          "type": "string"
        }
      }
    },
    "knowledgeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "文本",
        "图片列表"
      ],
      "properties": {
        "系统建模编码": {
          "type": "string"
        },
        "文本": {
          "type": "string"
        },
        "图片列表": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imageRef"
          }
        }
      }
    },
    "resourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "资源分类",
        "资源描述"
      ],
      "properties": {
        "资源分类": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "资源名称": {
          "type": "string"
        },
        "资源描述": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "链接": {
          "type": "string"
        },
        "定位": {
          "type": "string"
        }
      }
    },
    "fileResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "文件名称"
      ],
      "properties": {
        "文件名称": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "文件类型": {
          "type": "string"
        },
        "文件地址": {
          "type": "string"
        },
        "文件大小": {
          "type": "string"
        },
        "说明": {
          "type": "string"
        }
      }
    },
    "richTextBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "类型",
            "内容"
          ],
          "properties": {
            "类型": {
              "const": "文本"
            },
            "内容": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "类型",
            "地址"
          ],
          "properties": {
            "类型": {
              "const": "图片"
            },
            "地址": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "说明": {
              "type": "string"
            }
          }
        }
      ]
    },
    "richTextContent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/richTextBlock"
      }
    },
    "timeAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "课上分钟",
        "课下分钟"
      ],
      "properties": {
        "课上分钟": {
          "type": "integer",
          "minimum": 0
        },
        "课下分钟": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "courseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "课程名称",
        "课程类型",
        "教学形式",
        "适用专业",
        "学生层次",
        "学时安排",
        "任务内容"
      ],
      "properties": {
        "课程名称": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "课程类型": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "教学形式": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "适用专业": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "学生层次": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "学时安排": {
          "$ref": "#/$defs/timeAllocation"
        },
        "任务内容": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "learningGoals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "知识目标",
        "能力目标",
        "素质目标"
      ],
      "properties": {
        "知识目标": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/knowledgePoint"
          }
        },
        "能力目标": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "素质目标": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "teachingMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "方式",
        "其他"
      ],
      "properties": {
        "方式": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "讲授",
              "小组讨论",
              "答疑",
              "实验",
              "实训",
              "自主学习",
              "翻转课堂",
              "案例分析",
              "项目实践",
              "其他"
            ]
          }
        },
        "其他": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "任务id",
        "排序",
        "任务名称",
        "知识建模图",
        "知识组块",
        "任务描述",
        "任务时长分钟",
        "学习地点",
        "教学方式",
        "师生交互过程",
        "学习成果",
        "评价标准",
        "学习资源",
        "上传资源",
        "备注"
      ],
      "properties": {
        "任务id": {
          "$ref": "#/$defs/idString"
        },
        "排序": {
          "type": "integer",
          "minimum": 1
        },
        "任务名称": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "知识建模图": {
          "$ref": "#/$defs/knowledgeMap"
        },
        "知识组块": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "任务描述": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "任务时长分钟": {
          "type": "integer",
          "minimum": 1
        },
        "学习地点": {
          "$ref": "#/$defs/location"
        },
        "教学方式": {
          "$ref": "#/$defs/teachingMethod"
        },
        "师生交互过程": {
          "$ref": "#/$defs/richTextContent"
        },
        "学习成果": {
          "$ref": "#/$defs/richTextContent"
        },
        "评价标准": {
          "$ref": "#/$defs/richTextContent"
        },
        "学习资源": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceDescriptor"
          }
        },
        "上传资源": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileResource"
          }
        },
        "备注": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "活动id",
        "排序",
        "活动名称",
        "知识建模图",
        "活动目标",
        "导入任务描述",
        "师生交互过程",
        "时间分配",
        "课上资源",
        "课下资源",
        "任务序列"
      ],
      "properties": {
        "活动id": {
          "$ref": "#/$defs/idString"
        },
        "排序": {
          "type": "integer",
          "minimum": 1
        },
        "活动名称": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "知识建模图": {
          "$ref": "#/$defs/knowledgeMap"
        },
        "活动目标": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/knowledgePoint"
          }
        },
        "导入任务描述": {
          "type": "string"
        },
        "师生交互过程": {
          "$ref": "#/$defs/richTextContent"
        },
        "时间分配": {
          "$ref": "#/$defs/timeAllocation"
        },
        "课上资源": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceDescriptor"
          }
        },
        "课下资源": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceDescriptor"
          }
        },
        "任务序列": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    }
  }
}
