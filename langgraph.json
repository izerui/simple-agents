{
  "dependencies": ["."],
  "graphs": {
    "research": "./src/graph.py:agent"
  },
  "env": ".env",
  "dockerfile_lines":  [
    "RUN apt-get update && apt-get install -y poppler-data poppler-utils && rm -rf /var/lib/apt/lists/*"
  ],
  "python_version": "3.12",
  "http": {
    "app": "./src/webapp.py:app",
    "cors": {
      "allow_origins": ["*"],
      "allow_methods": ["*"],
      "allow_headers": ["*"],
      "allow_credentials": false
    }
  },
  "watch": {
    "ignore": ["data/"]
  }
}